      "license_link": "[网站显示的许可](https://creativecommons.org/licenses/by-sa/4.0/)",
      "capture_scope": "selected_quotation_snapshot_not_entire_page",
      "verification": "assistant_web_read_not_independent_human_review",
      "quotes": [
        {
          "quote_id": "L2-A",
          "locator": "国、山与部洲",
          "text": "這部書單表東勝神洲。海外有一國土，名曰傲來國。國近大海，海中有一座名山，喚為花果山。"
        },
        {
          "quote_id": "L2-B",
          "locator": "出生山",
          "text": "我只記得花果山上有一塊仙石，其年石破，我便生也。"
        },
        {
          "quote_id": "L2-C",
          "locator": "山洞与神仙",
          "text": "此山叫做靈臺方寸山，山中有座斜月三星洞，那洞中有一個神仙，稱名須菩提祖師。"
        },
        {
          "quote_id": "L2-D",
          "locator": "授名",
          "text": "與你起個法名叫做『孫悟空』，好麼？"
        },
        {
          "quote_id": "L2-E",
          "locator": "见祖师及拜师，需与 L2-C、L2-D 联合核验",
          "text": "見那菩提祖師端坐在臺上；美猴王一見，倒身下拜，磕頭不計其數，口中只道：「師父，師父，我弟子志心朝禮，志心朝禮。」",
          "capture_note": "两处原文短片段以分号连接；不是连续逐字引文"
        }
      ]
    },
    {
      "source_id": "SRC-H1",
      "domain": "history",
      "title": "《史记》卷七·项羽本纪",
      "author_attribution": "司马迁",
      "url": "https://zh.wikisource.org/wiki/%E5%8F%B2%E8%A8%98%2F%E5%8D%B7007",
      "revision_url": "https://zh.wikisource.org/w/index.php?title=%E5%8F%B2%E8%A8%98%2F%E5%8D%B7007&oldid=5978360",
