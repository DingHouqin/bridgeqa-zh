      "capture_scope": "selected_quotation_snapshot_not_entire_page",
      "verification": "assistant_web_read_not_independent_human_review",
      "quotes": [
        {
          "quote_id": "H2-A",
          "locator": "姓名、表字与籍贯",
          "text": "陳勝者，陽城人也，字涉。吳廣者，陽夏人也，字叔。"
        },
        {
          "quote_id": "H2-B",
          "locator": "早期职务",
          "text": "陳勝自立為將軍，吳廣為都尉。"
        },
        {
          "quote_id": "H2-C",
          "locator": "张楚称王",
          "text": "陳涉乃立為王，號為張楚。"
        },
        {
          "quote_id": "H2-D",
          "locator": "假王与任务",
          "text": "乃以吳叔為假王，監諸將以西擊滎陽。"
        }
      ]
    }
  ]
