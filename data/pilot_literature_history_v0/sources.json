      "quotes": [
        {
          "quote_id": "L1-A",
          "locator": "李儒询问及李肃献策",
          "text": "卓問李儒：「此言可乎？」儒曰：「主公欲取天下，何惜一馬？」"
        },
        {
          "quote_id": "L1-B",
          "locator": "送礼、引见和拜认义父",
          "text": "李肅齎了禮物，投呂布寨來。"
        },
        {
          "quote_id": "L1-C",
          "locator": "赤兔的赠予者",
          "text": "赤兔馬亦董公所贈也。"
        },
        {
          "quote_id": "L1-D",
          "locator": "引见与称呼",
          "text": "次日，布持丁原首級，往見李肅。肅遂引布見卓。"
        },
        {
          "quote_id": "L1-E",
          "locator": "该次拜认与授官",
          "text": "布納卓坐而拜之曰：「公若不棄，布請拜為義父。」"
        },
        {
          "quote_id": "L1-F",
          "locator": "董卓之弟",
          "text": "封弟董旻為左將軍鄠侯"
        },
        {
          "quote_id": "L1-G",
          "locator": "丁原别称",
          "text": "某在丁建陽處，亦出於無奈。"
        }
      ]
    },
    {
      "source_id": "SRC-L2",
      "domain": "literature",
      "title": "《西游记》第一回",
      "author_attribution": "吴承恩（网站署名；不作为作者归属考题）",
      "url": "https://zh.wikisource.org/wiki/%E8%A5%BF%E9%81%8A%E8%A8%98%2F%E7%AC%AC001%E5%9B%9E",
