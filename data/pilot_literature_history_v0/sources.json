      "retrieved_at": "2026-10-07",
      "license_displayed": "CC BY-SA 4.0; 页面附加条款可能适用，古籍底本文本与网站编校贡献分别考虑",
      "license_link": "[网站显示的许可](https://creativecommons.org/licenses/by-sa/4.0/)",
      "capture_scope": "selected_quotation_snapshot_not_entire_page",
      "verification": "assistant_web_read_not_independent_human_review",
      "quotes": [
        {
          "quote_id": "H1-A",
          "locator": "身份、籍贯与季父",
          "text": "項籍者，下相人也，字羽。初起時，年二十四。其季父項梁，梁父即楚將項燕，為秦將王翦所戮者也。"
        },
        {
          "quote_id": "H1-B",
          "locator": "求助书信与官署",
          "text": "項梁嘗有櫟陽逮，乃請蘄獄掾曹咎書抵櫟陽獄掾司馬欣，以故事得已。"
        },
        {
          "quote_id": "H1-C",
          "locator": "避仇",
          "text": "項梁殺人，與籍避仇於吳中。"
        },
        {
          "quote_id": "H1-D",
          "locator": "起事月份",
          "text": "秦二世元年七月，陳涉等起大澤中。其九月，會稽守通謂梁曰"
        },
        {
          "quote_id": "H1-E",
          "locator": "该阶段身份",
          "text": "於是梁為會稽守，籍為裨將，徇下縣。"
        }
      ]
    },
    {
      "source_id": "SRC-H2",
      "domain": "history",
      "title": "《史记》卷四十八·陈涉世家",
      "author_attribution": "司马迁",
      "url": "https://zh.wikisource.org/wiki/%E5%8F%B2%E8%A8%98%2F%E5%8D%B7048",
