{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bridgeqa-zh:sample:0.1",
  "title": "BridgeQA labeled sample",
  "type": "object",
  "required": ["schema_version", "sample_id", "seed_id", "pair_id", "split", "origin", "domain", "track", "variant", "question", "question_language", "answer", "topology", "hop_count", "documents", "gold_support", "reasoning_path", "language_condition", "crosslingual_mode", "attack", "provenance", "qc"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "sample_id": {"type": "string", "minLength": 1},
    "seed_id": {"type": "string", "minLength": 1},
    "pair_id": {"type": ["string", "null"]},
    "split": {"enum": ["example", "dev_public", "test_hidden"]},
    "origin": {"enum": ["native_zh", "translated_seed", "fictional_fixture"]},
    "domain": {"type": "string", "minLength": 1},
    "track": {"const": "context_attack"},
    "variant": {"enum": ["gold_only", "clean_control", "adversarial"]},
    "question": {"type": "string", "minLength": 1},
    "question_language": {"enum": ["zh", "en"]},
    "answer": {"type": "object", "required": ["canonical_id", "text", "aliases", "type"], "properties": {"canonical_id": {"type": "string", "minLength": 1}, "text": {"type": "string"}, "aliases": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "type": {"enum": ["entity", "date", "number", "string"]}}, "additionalProperties": false},
    "topology": {"const": "chain"},
    "hop_count": {"type": "integer", "minimum": 2, "maximum": 4},
    "documents": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/document"}},
    "gold_support": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/evidence"}},
    "reasoning_path": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/step"}},
    "language_condition": {"type": "string", "pattern": "^[ZE]{2,4}$"},
    "crosslingual_mode": {"enum": ["none", "controlled_parallel", "authentic_complementary"]},
    "attack": {"oneOf": [{"type": "null"}, {"type": "object", "required": ["primary_type", "target_hop", "secondary_tags", "source_method"], "properties": {"primary_type": {"type": "string", "minLength": 1}, "target_hop": {"type": "integer", "minimum": 1, "maximum": 4}, "secondary_tags": {"type": "array", "items": {"type": "string"}}, "source_method": {"type": "string"}, "expected_decoy_answer": {"type": ["string", "null"]}, "changed_sentences": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}}, "additionalProperties": false}]},
    "provenance": {"type": "object", "required": ["is_fictional", "source_dataset", "source_id", "sources", "construction_method"], "properties": {"is_fictional": {"type": "boolean"}, "source_dataset": {"type": ["string", "null"]}, "source_id": {"type": ["string", "null"]}, "sources": {"type": "array", "items": {"type": "object", "required": ["url", "snapshot_date", "license"], "properties": {"url": {"type": "string"}, "snapshot_date": {"type": "string"}, "license": {"type": "string"}, "file_hash": {"type": "string"}}, "additionalProperties": false}}, "construction_method": {"type": "string"}, "translation_revision": {"type": ["string", "null"]}}, "additionalProperties": false},
    "qc": {"type": "object", "required": ["status", "human_verified"], "properties": {"status": {"enum": ["candidate", "under_review", "accepted", "rejected", "fixture_only"]}, "human_verified": {"type": "boolean"}, "review_ids": {"type": "array", "items": {"type": "string"}}, "length_matched": {"type": "boolean"}}, "additionalProperties": false}
  },
  "additionalProperties": false,
  "$defs": {
    "evidence": {"type": "object", "required": ["doc_id", "sent_id"], "properties": {"doc_id": {"type": "string", "minLength": 1}, "sent_id": {"type": "integer", "minimum": 0}}, "additionalProperties": false},
    "step": {"type": "object", "required": ["hop", "head", "relation", "tail", "evidence"], "properties": {"hop": {"type": "integer", "minimum": 1}, "head": {"type": "string"}, "relation": {"type": "string"}, "tail": {"type": "string"}, "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}}, "additionalProperties": false},
    "document": {"type": "object", "required": ["doc_id", "title", "language", "sentences"], "properties": {"doc_id": {"type": "string", "minLength": 1}, "title": {"type": "string"}, "language": {"enum": ["zh", "en"]}, "sentences": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["sent_id", "text"], "properties": {"sent_id": {"type": "integer", "minimum": 0}, "text": {"type": "string", "minLength": 1}}, "additionalProperties": false}}}, "additionalProperties": false}
  }
}
