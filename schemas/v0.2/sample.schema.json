{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.2"
    },
    "sample_id": {
      "type": "string",
      "pattern": "^q_[0-9a-f]{24}$"
    },
    "seed_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "source_cluster": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "pair_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "split": {
      "enum": [
        "example",
        "dev_public",
        "test_hidden"
      ]
    },
    "origin": {
      "enum": [
        "fictional_fixture",
        "native_zh"
      ]
    },
    "domain": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "variant": {
      "enum": [
        "gold_only",
        "clean_control",
        "adversarial"
      ]
    },
    "question": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "question_language": {
      "const": "zh"
    },
    "hop_count": {
      "type": "integer",
      "minimum": 2,
      "maximum": 4
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "doc_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "title": {
            "type": "string"
          },
          "language": {
            "const": "zh"
          },
          "sentences": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sent_id": {
                  "type": "integer",
                  "minimum": 0
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "required": [
                "sent_id",
                "text"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "uniqueItems": false
          }
        },
        "required": [
          "doc_id",
          "title",
          "language",
          "sentences"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": false
    },
    "answer": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "type": {
          "enum": [
            "entity",
            "date",
            "number",
            "string"
          ]
        }
      },
      "required": [
        "text",
        "aliases",
        "type"
      ],
      "additionalProperties": false
    },
    "entity_aliases": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "minItems": 0,
        "uniqueItems": true
      }
    },
    "proofs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "hop": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4
                },
                "head": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "relation": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "tail": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "qualifier": {
                  "type": "string"
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "doc_id": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      },
                      "sent_id": {
                        "type": "integer",
                        "minimum": 0
                      }
                    },
                    "required": [
                      "doc_id",
                      "sent_id"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 1,
                  "uniqueItems": true
                }
              },
              "required": [
                "hop",
                "head",
                "relation",
                "tail",
                "qualifier",
                "evidence"
              ],
              "additionalProperties": false
            },
            "minItems": 2,
            "uniqueItems": false
          }
        },
        "required": [
          "steps"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": false
    },
    "attack": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "primary_type": {
              "enum": [
                "false_bridge",
                "redundant",
                "misleading_relation"
              ]
            },
            "target_hop": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            },
            "changed_sentences": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "doc_id": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "sent_id": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "doc_id",
                  "sent_id"
                ],
                "additionalProperties": false
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "source_method": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "required": [
            "primary_type",
            "target_hop",
            "changed_sentences",
            "source_method"
          ],
          "additionalProperties": false
        }
      ]
    },
    "provenance": {
      "type": "object",
      "properties": {
        "construction_method": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source_id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "url": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "citation": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "accessed_at": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "license": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "text_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "source_id",
              "url",
              "citation",
              "version",
              "accessed_at",
              "license",
              "text_sha256"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "uniqueItems": false
        }
      },
      "required": [
        "construction_method",
        "sources"
      ],
      "additionalProperties": false
    },
    "qc": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "candidate",
            "under_review",
            "accepted",
            "rejected",
            "fixture_only"
          ]
        },
        "human_verified": {
          "type": "boolean"
        },
        "review_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "status",
        "human_verified",
        "review_ids"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "sample_id",
    "seed_id",
    "source_cluster",
    "pair_id",
    "split",
    "origin",
    "domain",
    "variant",
    "question",
    "question_language",
    "hop_count",
    "documents",
    "answer",
    "entity_aliases",
    "proofs",
    "attack",
    "provenance",
    "qc"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bridgeqa-zh:sample:0.2",
  "title": "BridgeQA 0.2 sample"
}
