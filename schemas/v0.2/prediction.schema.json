{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.2"
    },
    "sample_id": {
      "type": "string",
      "pattern": "^q_[0-9a-f]{24}$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "status": {
      "enum": [
        "ok",
        "error",
        "abstain"
      ]
    },
    "answer": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            }
          },
          "required": [
            "text"
          ],
          "additionalProperties": false
        }
      ]
    },
    "support": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "doc_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "sent_id": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "doc_id",
          "sent_id"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "submitted_steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "hop": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "head": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "relation": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "tail": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "qualifier": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "doc_id": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "sent_id": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "doc_id",
                "sent_id"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "hop",
          "head",
          "relation",
          "tail",
          "qualifier",
          "evidence"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": false
    },
    "raw_output": {
      "type": [
        "string",
        "null"
      ]
    },
    "error_message": {
      "type": [
        "string",
        "null"
      ]
    },
    "latency_ms": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    }
  },
  "required": [
    "schema_version",
    "sample_id",
    "run_id",
    "status",
    "answer",
    "support",
    "submitted_steps"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          }
        }
      },
      "then": {
        "properties": {
          "answer": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "abstain"
          }
        }
      },
      "then": {
        "properties": {
          "answer": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bridgeqa-zh:prediction:0.2",
  "title": "BridgeQA 0.2 prediction"
}
